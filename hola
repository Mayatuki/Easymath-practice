    ];

    const PAGE_SIZE = 12;          // cuántos juegos se muestran por tanda
    let visibleCount = PAGE_SIZE;  // cuántos hay visibles ahora
    let activeCategory = "Todos";
    let searchTerm = "";
    let selectedGame = null;

    function getFiltered() {
      return games.filter(g => {
        const okCat = activeCategory === "Todos" || g.category === activeCategory;
        const okTerm = !searchTerm || g.title.toLowerCase().includes(searchTerm);
        return okCat && okTerm;
      });
    }

    function createCard(game) {
      return `
        <article class="card" onclick="openGame('${game.id}')">
          <div class="thumb">${game.emoji}</div>
          <div class="card-body">
            <h3 class="card-title">${game.title}</h3>
            <div class="card-cat">${game.category}</div>
          </div>
        </article>
      `;
    }

    function renderCategories() {
      const list = document.getElementById('categoryList');
      list.innerHTML = `<button class="chip ${activeCategory === 'Todos' ? 'active' : ''}" onclick="filterCategory('Todos')">🎮 Todos</button>` +
        categories.map(c => `
          <button class="chip ${activeCategory === c.name ? 'active' : ''}" onclick="filterCategory('${c.name}')">${c.emoji} ${c.name}</button>
        `).join('');
    }

    function renderGames() {
      const filtered = getFiltered();
      const empty = '<p style="color:var(--muted)">No se encontraron juegos.</p>';

      document.getElementById('newGames').innerHTML =
        filtered.slice(0, 8).map(createCard).join('') || empty;

      const shown = filtered.slice(0, visibleCount);
      document.getElementById('allGames').innerHTML = shown.map(createCard).join('') || empty;

      // El botón sólo aparece si quedan juegos por mostrar (ya no se repiten)
      const btn = document.getElementById('loadMore');
      if (visibleCount >= filtered.length) {
        btn.style.display = 'none';
      } else {
        btn.style.display = 'inline-block';
        btn.textContent = `Cargar más juegos (${filtered.length - visibleCount})`;
      }
    }

    function renderTop() {
      document.getElementById('topList').innerHTML = games.slice(0, 10).map((g, i) => `
        <li>
          <a href="#" onclick="openGame('${g.id}'); return false;">
            <span class="top-number">${i + 1}</span>
            <span class="top-emoji">${g.emoji}</span>
            <span class="top-title">${g.title}</span>
          </a>
        </li>
      `).join('');
    }

    function filterCategory(name) {
      activeCategory = name;
      visibleCount = PAGE_SIZE;
      renderCategories();
      renderGames();
      document.getElementById('todos').scrollIntoView({ behavior: 'smooth' });
    }

    /* ===== Abrir el juego dentro de la página (iframe) ===== */
    function openGame(id) {
      selectedGame = games.find(g => g.id === id);
      if (!selectedGame) return;

      document.getElementById('modalEmoji').textContent = selectedGame.emoji;
      document.getElementById('modalTitle').textContent = selectedGame.title;
      document.getElementById('modalCat').textContent = selectedGame.category;

      const body = document.getElementById('modalBody');
      const openTab = document.getElementById('openTab');

      if (selectedGame.url) {
        body.innerHTML = `<iframe src="${selectedGame.url}" allowfullscreen allow="autoplay; fullscreen; gamepad"></iframe>`;
        openTab.href = selectedGame.url;
        openTab.style.display = 'inline-block';
      } else {
        body.innerHTML = `<div class="modal-fallback">
            Este juego todavía no tiene enlace configurado.<br />
            Añade su dirección en el campo <code>url</code> dentro de la lista <code>games</code> del código.
          </div>`;
        openTab.style.display = 'none';
      }

      document.getElementById('modal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('modal').classList.remove('active');
      document.getElementById('modalBody').innerHTML = ''; // detiene el juego / audio
      document.body.style.overflow = '';
      selectedGame = null;
    }

    function scrollToGames() {
      document.getElementById('todos').scrollIntoView({ behavior: 'smooth' });
    }

    /* ===== Botón de pánico ===== */
    function panic() {
      try { closeModal(); } catch (e) {}
      window.location.replace(PANIC_URL);
    }

    document.addEventListener('keydown', (e) => {
      // No dispara mientras escribes en el buscador (salvo con Escape)
      const typing = document.activeElement && document.activeElement.tagName === 'INPUT';
      if (typing && e.key !== 'Escape') return;
      if (PANIC_KEYS.includes(e.key)) {
        e.preventDefault();
        panic();
      }
    });

    document.getElementById('searchInput').addEventListener('input', (e) => {
      searchTerm = e.target.value.toLowerCase().trim();
      visibleCount = PAGE_SIZE;
      renderGames();
    });

    document.getElementById('loadMore').addEventListener('click', () => {
      visibleCount += PAGE_SIZE;
      renderGames();
    });

    document.getElementById('modal').addEventListener('click', (e) => {
      if (e.target.id === 'modal') closeModal();
    });

    renderCategories();
    renderGames();
    renderTop();
  </script>
</body>
</html>
