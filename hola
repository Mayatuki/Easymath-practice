    <p style="margin-top:0.9rem;">© 2026 Mayatukis Class</p>
    <p class="disclaimer">Casual use in educational environments. Content is organized for ease of access and does not represent or replace any official school platform.</p>
  </footer>

  <!-- Reproductor de juego -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-head">
        <span id="modalEmoji" style="font-size:1.4rem;">🎮</span>
        <h3 id="modalTitle">Título</h3>
        <span class="cat" id="modalCat"></span>
