<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAYATUKIS CLASS - Classroom Games</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #090a10;
            --card-bg: #121420;
            --pink-neon: #ff2a8d;
            --cyan-neon: #00f0ff;
            --text-main: #ffffff;
            --text-muted: #8c93b0;
            --border-color: rgba(255, 42, 141, 0.2);
            --surface: #181b2c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            padding: 20px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1300px;
            margin: 0 auto 30px auto;
            padding: 10px 0;
        }

        .logo {
            font-family: 'Press Start 2P', cursive;
            font-size: 16px;
            color: var(--pink-neon);
            text-shadow: 0 0 10px rgba(255, 42, 141, 0.6);
        }

        .logo span {
            color: var(--cyan-neon);
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--text-main);
        }

        .top-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 8px 15px;
            border-radius: 8px;
            color: white;
            font-size: 13px;
            outline: none;
        }

        .panic-panel-inline {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface);
            border: 1px solid var(--border-color);
            padding: 4px 8px;
            border-radius: 8px;
        }

        .panic-input {
            background: transparent;
            border: none;
            color: var(--cyan-neon);
            font-size: 12px;
            width: 130px;
            outline: none;
        }

        .btn-panic-key {
            background: var(--pink-neon);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(255, 42, 141, 0.4);
            transition: transform 0.2s;
        }

        .btn-panic-key:hover {
            transform: scale(1.05);
        }

        .btn-panic-key.listening {
            background: var(--cyan-neon);
            color: #000;
            animation: blink 0.8s infinite alternate;
        }

        @keyframes blink {
            from { opacity: 0.6; }
            to { opacity: 1; }
        }

        .main-container {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .hero-banner {
            background: linear-gradient(180deg, rgba(255, 42, 141, 0.05) 0%, rgba(0, 0, 0, 0.4) 100%), var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 50px 20px;
            text-align: center;
            box-shadow: 0 0 30px rgba(255, 42, 141, 0.1);
        }

        .hero-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
        }

        .hero-title .highlight {
            color: var(--pink-neon);
            text-shadow: 0 0 15px rgba(255, 42, 141, 0.8);
        }

        .hero-sub {
            color: var(--text-muted);
            font-size: 14px;
            max-width: 500px;
            margin: 0 auto 25px auto;
        }

        .btn-play-now {
            background: linear-gradient(90deg, var(--pink-neon), #c026d3);
            border: none;
            color: white;
            font-family: 'Press Start 2P', cursive;
            font-size: 12px;
            padding: 15px 30px;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(255, 42, 141, 0.5);
            transition: all 0.3s;
        }

        .category-bar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .cat-btn {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s;
        }

        .cat-btn.active, .cat-btn:hover {
            border-color: var(--pink-neon);
            color: white;
            background: rgba(255, 42, 141, 0.15);
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 25px;
        }

        .section-header {
            font-family: 'Press Start 2P', cursive;
            font-size: 14px;
            margin-bottom: 20px;
            color: white;
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 15px;
        }

        .game-card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .game-card:hover {
            transform: translateY(-5px);
            border-color: var(--pink-neon);
            box-shadow: 0 5px 20px rgba(255, 42, 141, 0.2);
        }

        .game-thumb {
            width: 100%;
            height: 100px;
            background: #1c2035;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 35px;
            margin-bottom: 10px;
        }

        .game-card-title {
            font-size: 13px;
            font-weight: 700;
            color: white;
            margin-bottom: 3px;
        }

        .game-card-cat {
            font-size: 11px;
            color: var(--text-muted);
        }

        .top10-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
        }

        .top10-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 11px;
            color: var(--pink-neon);
            margin-bottom: 20px;
        }

        .top10-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .top10-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 600;
        }

        .top10-rank {
            color: var(--pink-neon);
            font-weight: 800;
            width: 15px;
        }

        .game-view-container {
            display: none;
            width: 100%;
            height: 550px;
            background: black;
            border-radius: 16px;
            border: 2px solid var(--pink-neon);
            overflow: hidden;
            position: relative;
            margin-bottom: 25px;
        }

        .close-game-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            z-index: 10;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">MAYATUKIS <span>CLASS</span></div>
        <nav>
            <ul>
                <li><a href="#">Nuevos</a></li>
                <li><a href="#">Top 10</a></li>
                <li><a href="#">Categorías</a></li>
                <li><a href="#">Todos</a></li>
                <li><a href="https://instagram.com/mayatukinaldo/" target="_blank">Instagram</a></li>
            </ul>
        </nav>
        
        <div class="top-controls">
            <input type="text" class="search-box" id="searchInput" placeholder="Buscar juego..." oninput="filterGames()">
            
            <div class="panic-panel-inline">
                <input type="text" class="panic-input" id="panicUrl" value="https://google.com" placeholder="URL Redirección">
                <button class="btn-panic-key" id="btnPanicKey" onclick="setPanicKey()">Salir (<span id="keyText">Esc</span>)</button>
            </div>
        </div>
    </header>

    <div class="main-container">

        <div class="game-view-container" id="gameFrameContainer">
            <button class="close-game-btn" onclick="closeGame()">✕ Cerrar Juego</button>
            <iframe id="gameIframe" src=""></iframe>
        </div>

        <div class="hero-banner">
            <h1 class="hero-title">CLASS ROOM <span class="highlight">GAMES</span></h1>
            <p class="hero-sub">Juegos casuales organizados para acceder rápido. Sin descargas, todo en el navegador.</p>
            <button class="btn-play-now" onclick="document.getElementById('gamesSection').scrollIntoView({behavior: 'smooth'})">JUGAR AHORA</button>
        </div>

        <div class="category-bar">
            <button class="cat-btn active" onclick="filterCategory('all', event)">🌸 Todos</button>
            <button class="cat-btn" onclick="filterCategory('accion', event)">💥 Acción</button>
            <button class="cat-btn" onclick="filterCategory('aventura', event)">🗺️ Aventura</button>
            <button class="cat-btn" onclick="filterCategory('carreras', event)">🏎️ Carreras</button>
            <button class="cat-btn" onclick="filterCategory('deportes', event)">⚽ Deportes</button>
            <button class="cat-btn" onclick="filterCategory('puzzle', event)">🧩 Puzzle</button>
        </div>

        <div class="content-grid" id="gamesSection">
            <div>
                <h3 class="section-header">. Juegos nuevos</h3>
                <div class="games-grid" id="gamesGrid"></div>
            </div>

            <div class="top10-card">
                <div class="top10-title">TOP 10 HOY</div>
                <ul class="top10-list">
                    <li class="top10-item"><span class="top10-rank">1</span> 🏁 Neon Racer 3000</li>
                    <li class="top10-item"><span class="top10-rank">2</span> 🏃 Pixel Runner</li>
                    <li class="top10-item"><span class="top10-rank">3</span> 🧩 Bloque Manía</li>
                    <li class="top10-item"><span class="top10-rank">4</span> ⚽ Penalti Mundial</li>
                    <li class="top10-item"><span class="top10-rank">5</span> 🥷 Pixel Ninja</li>
                    <li class="top10-item"><span class="top10-rank">6</span> 🚀 Space Blaster</li>
                    <li class="top10-item"><span class="top10-rank">7</span> 🃏 Solitario Deluxe</li>
                    <li class="top10-item"><span class="top10-rank">8</span> 🍔 Cocina Loca</li>
                    <li class="top10-item"><span class="top10-rank">9</span> 🏰 Torre Infinita</li>
                    <li class="top10-item"><span class="top10-rank">10</span> 🏎️ Drift Kings</li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        // LISTA INICIAL LOCAL PARA QUE SE MUESTRE SIEMPRE AUNQUE ESTÉS EN ARCHIVO LOCAL
        let gamesList = [
            { id: "1", title: "Neon Racer 3000", cat: "carreras", icon: "🏁", url: "https://snokido.com" },
            { id: "2", title: "Pixel Runner", cat: "aventura", icon: "🏃", url: "https://snokido.com" },
            { id: "3", title: "Bloque Manía", cat: "puzzle", icon: "🧩", url: "https://snokido.com" },
            { id: "4", title: "Penalti Mundial", cat: "deportes", icon: "⚽", url: "https://snokido.com" },
            { id: "5", title: "Pixel Ninja", cat: "accion", icon: "🥷", url: "https://snokido.com" },
            { id: "6", title: "Space Blaster", cat: "accion", icon: "🚀", url: "https://snokido.com" }
        ];

        // INTENTA METER EL FETCH SOLO SI ESTÁS EN UN SERVIDOR REAL
        async function tryLoadExternalJSON() {
            if (window.location.protocol.startsWith('http')) {
                try {
                    const res = await fetch('URL_DE_MI_BASE_DE_DATOS.json');
                    if (res.ok) {
                        gamesList = await res.json();
                        renderGames(gamesList);
                    }
                } catch (e) {
                    console.log("Servidor detectado, pero usando base inicial.");
                }
            }
        }

        function renderGames(data) {
            const grid = document.getElementById('gamesGrid');
            grid.innerHTML = '';

            data.forEach(game => {
                const card = document.createElement('div');
                card.className = 'game-card';
                card.onclick = () => openGame(game.url);
                card.innerHTML = `
                    <div class="game-thumb">${game.icon}</div>
                    <div class="game-card-title">${game.title}</div>
                    <div class="game-card-cat">${game.cat}</div>
                `;
                grid.appendChild(card);
            });
        }

        function openGame(url) {
            const container = document.getElementById('gameFrameContainer');
            const iframe = document.getElementById('gameIframe');
            iframe.src = url;
            container.style.display = 'block';
            container.scrollIntoView({ behavior: 'smooth' });
        }

        function closeGame() {
            const container = document.getElementById('gameFrameContainer');
            const iframe = document.getElementById('gameIframe');
            iframe.src = '';
            container.style.display = 'none';
        }

        function filterGames() {
            const text = document.getElementById('searchInput').value.toLowerCase();
            const filtered = gamesList.filter(g => g.title.toLowerCase().includes(text));
            renderGames(filtered);
        }

        function filterCategory(cat, event) {
            document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            if(event) event.currentTarget.classList.add('active');

            if (cat === 'all') {
                renderGames(gamesList);
            } else {
                const filtered = gamesList.filter(g => g.cat === cat);
                renderGames(filtered);
            }
        }

        // PÁNICO
        let selectedPanicKey = 'Escape';
        let listeningForKey = false;

        function setPanicKey() {
            listeningForKey = true;
            const btn = document.getElementById('btnPanicKey');
            btn.classList.add('listening');
            btn.innerText = 'Presiona...';
        }

        window.addEventListener('keydown', (e) => {
            if (listeningForKey) {
                e.preventDefault();
                selectedPanicKey = e.key;
                listeningForKey = false;

                const btn = document.getElementById('btnPanicKey');
                btn.classList.remove('listening');
                btn.innerHTML = `Salir (<span id="keyText">${selectedPanicKey}</span>)`;
                return;
            }

            if (e.target.tagName === 'INPUT') return;

            if (e.key === selectedPanicKey) {
                let redirectUrl = document.getElementById('panicUrl').value.trim() || 'https://google.com';
                if (!redirectUrl.startsWith('http://') && !redirectUrl.startsWith('https://')) {
                    redirectUrl = 'https://' + redirectUrl;
                }
                window.open(redirectUrl, '_blank');
                window.close();
                setTimeout(() => {
                    window.location.replace("https://google.com");
                }, 100);
            }
        });

        // RENDERIZAR DE INMEDIATO AL ABRIR
        renderGames(gamesList);
        tryLoadExternalJSON();
    </script>
</body>
</html>
