<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mayatukis Class — Class Room Games</title>
  <meta name="description" content="Mayatukis Class: colección de juegos casuales organizados para acceso rápido en entornos educativos. Sin descargas, directo en el navegador." />
  <meta property="og:title" content="Mayatukis Class — Class Room Games" />
  <meta property="og:description" content="Colección de juegos casuales organizados para acceso rápido en entornos educativos." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rubik:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #0d0b14;
      --surface: #161320;
      --surface-2: #1f1929;
      --border: #2d2440;
      --text: #f2eaff;
      --muted: #9f94b8;
      --primary: #ff3cac;
      --secondary: #00d4ff;
      --accent: #aaff00;
      --gold: #ffd166;
      --radius: 0.6rem;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Rubik', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      background-image:
        radial-gradient(circle at 10% 0%, rgba(255, 60, 172, 0.22), transparent 42%),
        radial-gradient(circle at 90% 0%, rgba(0, 212, 255, 0.18), transparent 42%);
      background-attachment: fixed;
    }
    .font-display { font-family: 'Press Start 2P', monospace; letter-spacing: -0.02em; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(13, 11, 20, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .nav {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 1rem;
    }
    .logo { font-size: 0.75rem; color: var(--primary); }
    .logo span { color: var(--secondary); }
    .nav-links {
      display: none;
      gap: 1.25rem;
      font-size: 0.9rem;
      font-weight: 500;
    }
    .nav-links a:hover { color: var(--primary); }
    .search {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .search input {
      display: none;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.45rem 0.75rem;
      border-radius: var(--radius);
      font-size: 0.85rem;
      width: 180px;
    }
    .btn {
      font-family: 'Press Start 2P', monospace;
      font-size: 0.65rem;
      border: none;
      cursor: pointer;
      padding: 0.6rem 1rem;
      border-radius: var(--radius);
      background: linear-gradient(135deg, var(--primary), #7b2cbf);
      color: #fff;
      box-shadow: 0 0 0 1px rgba(255, 60, 172, 0.5), 0 6px 20px -6px rgba(255, 60, 172, 0.55);
      transition: transform 0.15s ease;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-sm { padding: 0.5rem 0.75rem; font-size: 0.55rem; }
    .btn-lg { padding: 0.85rem 1.5rem; font-size: 0.75rem; }
    .btn-secondary {
      background: linear-gradient(135deg, var(--secondary), #2b6cb0);
      box-shadow: 0 0 0 1px rgba(0, 212, 255, 0.5), 0 6px 20px -6px rgba(0, 212, 255, 0.5);
    }
    .btn-panic {
      background: linear-gradient(135deg, #3a3350, #241f33);
      box-shadow: inset 0 0 0 1px var(--border);
      color: var(--muted);
    }
    .btn-panic:hover { color: var(--text); }

    /* Layout */
    .container { max-width: 1200px; margin: 0 auto; padding: 1rem; }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      margin-top: 1rem;
      min-height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background:
        linear-gradient(135deg, rgba(255, 60, 172, 0.25), rgba(0, 212, 255, 0.2)),
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><rect fill="%23110d18" width="200" height="200"/><path d="M0 100h200M100 0v200" stroke="%232d2440" stroke-width="1"/></svg>');
    }
    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0px, rgba(0,0,0,0.25) 1px, transparent 1px, transparent 3px);
    }
    .hero-content { position: relative; z-index: 1; padding: 1.5rem; }
    .hero h1 {
      font-size: 1rem;
      line-height: 1.8;
      margin: 0;
      text-shadow: 0 0 12px rgba(255, 60, 172, 0.6);
    }
    .hero h1 span { color: var(--primary); }
    .hero p { color: var(--muted); font-size: 0.95rem; max-width: 520px; margin: 0.75rem auto 0; }
    .hero .btn { margin-top: 1.25rem; }

    /* Section titles */
    .section-title { font-size: 0.7rem; margin: 1.5rem 0 0.75rem; }
    .section-title span { color: var(--primary); }

    /* Categories */
    .categories { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.45rem 0.75rem;
      border-radius: var(--radius);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: 0.15s;
      color: var(--text);
      font-family: inherit;
    }
    .chip:hover, .chip.active {
      border-color: var(--primary);
      color: var(--primary);
      background: rgba(255, 60, 172, 0.08);
    }

    /* Main grid */
    .main-grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }

    /* Game cards */
    .games-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); }
    .card {
      background: linear-gradient(160deg, var(--surface-2), var(--surface));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 0 1px rgba(255, 60, 172, 0.5), 0 8px 30px -8px rgba(255, 60, 172, 0.55);
    }
    .thumb {
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      background: linear-gradient(135deg, rgba(255,255,255,0.06), transparent);
    }
    .card-body { padding: 0.6rem 0.75rem; }
    .card-title {
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0;
    }
    .card-cat { margin-top: 0.3rem; font-size: 0.7rem; color: var(--muted); }

    /* Sidebar */
    .sidebar { display: flex; flex-direction: column; gap: 1rem; }
    .panel {
      background: linear-gradient(160deg, var(--surface-2), var(--surface));
      border-radius: var(--radius);
      padding: 1rem;
      box-shadow: 0 0 0 1px rgba(255, 60, 172, 0.5), 0 8px 30px -8px rgba(255, 60, 172, 0.55);
    }
    .panel h2 { font-size: 0.6rem; color: var(--primary); margin: 0 0 0.75rem; }
    .panel p { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.75rem; }
    .top-list { list-style: none; padding: 0; margin: 0; }
    .top-list li + li { margin-top: 0.5rem; }
    .top-list a { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
    .top-list a:hover { color: var(--secondary); }
    .top-number { width: 1.4rem; font-size: 0.65rem; color: var(--gold); font-family: 'Press Start 2P', monospace; }
    .top-emoji { font-size: 1rem; }
    .top-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* ===== ESPACIOS PARA ANUNCIOS / ADS =====
       Pega el código de tu anuncio dentro de cada .ad-slot y borra el texto "hola". */
    .ad-slot {
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      background: rgba(255,255,255,0.02);
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      text-align: center;
      padding: 1rem;
    }
    .ad-label {
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.6;
      margin: 1rem 0 0.35rem;
    }
    .ad-banner { min-height: 90px; }
    .ad-side { min-height: 250px; }

    /* Footer */
    footer {
      border-top: 1px solid var(--border);
      margin-top: 2rem;
      padding: 1.5rem 1rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--muted);
    }
    footer .brand { color: var(--secondary); font-family: 'Press Start 2P', monospace; font-size: 0.6rem; }
    .disclaimer { max-width: 640px; margin: 0.75rem auto 0; font-size: 0.7rem; opacity: 0.8; line-height: 1.6; }
    .social-links { display: flex; gap: 0.5rem; justify-content: center; margin-top: 0.75rem; flex-wrap: wrap; }
    .social-links a {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.45rem 0.8rem;
      font-size: 0.8rem;
      transition: 0.15s;
    }
    .social-links a:hover { border-color: var(--primary); color: var(--primary); }

    /* Modal / reproductor de juego */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.88);
      z-index: 50;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-overlay.active { display: flex; }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      max-width: 1000px;
      width: 100%;
      max-height: 92vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .modal-head {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .modal-head h3 { margin: 0; font-size: 0.95rem; flex: 1; }
    .modal-head .cat { font-size: 0.75rem; color: var(--muted); }
    .modal-body { flex: 1; background: #000; position: relative; min-height: 320px; }
    .modal-body iframe { width: 100%; height: 60vh; border: 0; display: block; }
    .modal-fallback {
      padding: 2rem 1.5rem;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
      background: var(--surface-2);
    }
    .modal-foot {
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
      align-items: center;
      padding: 0.75rem 1rem;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .modal-foot .hint { margin-right: auto; font-size: 0.7rem; color: var(--muted); }
    .btn-ghost { background: transparent; box-shadow: inset 0 0 0 1px var(--border); color: var(--text); }

    /* Responsive */
    @media (min-width: 640px) {
      .hero h1 { font-size: 1.5rem; }
      .games-grid { grid-template-columns: repeat(3, 1fr); }
      .nav-links { display: flex; }
      .search input { display: block; }
    }
    @media (min-width: 1024px) {
      .main-grid { grid-template-columns: 1fr 300px; }
      .games-grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>
</head>
<body>
