  <script>
    /* ========= CONFIGURACIÓN RÁPIDA ========= */
    // Botón de pánico: tecla y destino. Cambia estos valores a tu gusto.
    const PANIC_KEYS = ['Escape', '`'];                      // teclas que activan la salida
    const PANIC_URL  = 'https://classroom.google.com/';      // a dónde te manda
    // Red social para feedback (también está en el HTML del footer y del sidebar)
